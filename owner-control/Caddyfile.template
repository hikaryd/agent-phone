	# route preserves this security-critical order, including the terminal deny.
	route {
		header {
			-Server
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy same-origin
			Cache-Control no-store
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
		}
		header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self'; connect-src 'self' wss://__LAN_IP__:8443; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		respond @wrong_host 404
		basic_auth bcrypt "Phone owner" {
			__OWNER_USERNAME__ __OWNER_BCRYPT_HASH__
		}
		respond @noncanonical 404
		header @owner_page Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
		reverse_proxy @owner_page 127.0.0.1:8766 {
			header_up Host 127.0.0.1:8766
			header_up X-Phone-Control __CONTROL_TOKEN__
			header_up -Authorization
			header_up -Proxy-Authorization
			header_up -Cookie
			transport http {
				dial_timeout 3s
				response_header_timeout 40s
			}
		}
		reverse_proxy @owner_status 127.0.0.1:8766 {
			header_up Host 127.0.0.1:8766
			header_up X-Phone-Control __CONTROL_TOKEN__
			header_up -Authorization
			header_up -Proxy-Authorization
			header_up -Cookie
			transport http {
				dial_timeout 3s
				response_header_timeout 40s
			}
		}
		reverse_proxy @owner_action 127.0.0.1:8766 {
			header_up Host 127.0.0.1:8766
			header_up X-Phone-Control __CONTROL_TOKEN__
			header_up -Authorization
			header_up -Proxy-Authorization
			header_up -Cookie
			transport http {
				dial_timeout 3s
				response_header_timeout 40s
			}
		}
		respond @bad_method 405
		# Bundled HTTP server omits HTML MIME; keep nosniff, fix exact HTML only.
		header @html >Content-Type "text/html; charset=utf-8"
		header @mime_json >Content-Type application/json
		header @mime_oga >Content-Type audio/ogg
		header @mime_ttf >Content-Type font/ttf
		header @mime_png >Content-Type image/png
		redir @root /owner 302
		# The owner helper checks the lease throughout each WebSocket connection.
		reverse_proxy @websocket 127.0.0.1:8766 {
			header_up Host 127.0.0.1:8766
			header_up X-Phone-Control __CONTROL_TOKEN__
			header_up -Authorization
			header_up -Proxy-Authorization
			header_up -Cookie
			transport http {
				dial_timeout 3s
				response_header_timeout 10s
			}
		}
		file_server @owner_static {
			root __TERMUX_HOME__/phone-admin/static
		}
		reverse_proxy @assets 127.0.0.1:5800 {
			# Backend lacks HEAD; net/http suppresses response body for client HEAD.
			method GET
			header_up -Authorization
			header_up -Proxy-Authorization
			header_up -Cookie
			transport http {
				dial_timeout 3s
				response_header_timeout 10s
			}
		}
		respond 404
	}
