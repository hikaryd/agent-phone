# Caddy template. Render every placeholder from private configuration; see ../SETUP.md.
{
	admin off
	auto_https off
	# No access logs; discard runtime logs too (errors can contain request URLs).
	log {
		output discard
	}
	servers {
		protocols h1
		max_header_size 16KB
		timeouts {
			read_header 10s
			read_body 15s
			idle 2m
		}
	}
}

# Catch all TLS Host values on this exact bind; reject foreign Host in route.
https://:8443 {
	bind __LAN_IP__
	tls __TERMUX_HOME__/phone-admin/tls.crt __TERMUX_HOME__/phone-admin/tls.key

	@wrong_host expression `{http.request.hostport} != "__LAN_IP__:8443"`
	@bad_method not method GET HEAD
	@noncanonical expression `{http.request.uri}.split("?")[0] != {path} || {path}.contains("//") || "." in {path}.split("/") || ".." in {path}.split("/")`
	@root path /
	@html path /vnc.html
	@owner_page {
		method GET
		path /owner
		expression `{query} == ""`
	}
	@owner_status {
		method GET
		path /owner/status
		expression `{query} == ""`
	}
	@owner_static {
		method GET HEAD
		path /vnc.html /owner-session.js
	}
	@owner_action {
		method POST
		path /owner/start /owner/stop
		header Origin https://__LAN_IP__:8443
		expression `{query} == ""`
	}
	@websocket {
		path /websockify
		method GET
		header Upgrade websocket
		header_regexp Connection `(?i)(^|,)[\t ]*upgrade[\t ]*(,|$)`
		header Origin https://__LAN_IP__:8443
	}
	@mime_png {
		path /app/images/icons/novnc-120x120.png
		path /app/images/icons/novnc-144x144.png
